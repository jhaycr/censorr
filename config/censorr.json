{
  "subtitle_title_exclude": ["sdh", "hi", "cc"],
  "verbose": true,
  "output": "./output",
  "output_mode": "REMUX_ORIGINAL_VIDEO",
  "destination_policy": {
    "policy": "subfolder_tag",
    "tag": "[Censorr]",
    "separate_root": "/data/media/TV/Censorr"
  },
  "presets": {
    "movies": {
      "operations": [
        "extract_subtitles",
        "merge_subtitles", 
        "mask_subtitles",
        "extract_audio",
        "mute_audio",
        "audio_quality_check",
        "remux"
      ],
      "flags": {
        "language": "en",
        "subtitle_mode": "none",
        "create_subtitle_sidecar": true,
        "profanity_list_file": "config/profanity_list.json",
        "audio_transcode_to_original": true
      },
      "language_selector": { 
        "prefer_non_sdh": true 
      },
      "output": { 
        "output_mode": "REMUX_NEW_FILE",
        "embed_muted_audio": true 
      },
      "backup_default": false
    },
    "tv": {
      "operations": [
        "extract_subtitles",
        "merge_subtitles",
        "mask_subtitles", 
        "extract_audio",
        "mute_audio",
        "audio_quality_check",
        "remux"
      ],
      "flags": {
        "language": "en",
        "create_subtitle_sidecar": true,
        "profanity_list_file": "config/profanity_list.json",
        "audio_transcode_to_original": true
      },
      "language_selector": { 
        "prefer_non_sdh": true 
      },
      "output": { 
        "output_mode": "REMUX_NEW_FILE",
        "embed_muted_audio": true 
      },
      "destination_policy": {
        "policy": "subfolder_tag",
        "tag": "[Censorr]"
      },
      "backup_default": false
    }
  }
}