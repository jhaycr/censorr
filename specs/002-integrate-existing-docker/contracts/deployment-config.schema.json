{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/censorr/deployment-config.schema.json",
  "title": "CensorrDeploymentConfig",
  "type": "object",
  "required": ["enabled", "image_repo", "image_tag", "volumes"],
  "properties": {
    "enabled": {"type": "boolean", "default": true},
    "image_repo": {"type": "string", "minLength": 1},
    "image_tag": {"type": "string", "minLength": 1},
    "force_pull": {"type": "boolean", "default": false},
    "container_name": {"type": "string", "default": "censorr"},
    "user_id": {"type": ["integer", "null"], "minimum": 0},
    "group_id": {"type": ["integer", "null"], "minimum": 0},
    "volumes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["host", "container", "mode"],
        "properties": {
          "host": {"type": "string", "minLength": 1},
          "container": {"type": "string", "minLength": 1},
          "mode": {"type": "string", "enum": ["ro", "rw"]}
        },
        "additionalProperties": false
      }
    },
    "env": {
      "type": "object",
      "patternProperties": {
        "^[A-Z0-9_]+$": {"type": "string"}
      },
      "additionalProperties": false,
      "default": {}
    },
    "labels": {
      "type": "object",
      "patternProperties": {
        ".+": {"type": "string"}
      },
      "additionalProperties": false,
      "default": {}
    },
    "health": {
      "type": ["object", "null"],
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
            "items": {"type": "string"},
            "minItems": 1
        },
        "interval_seconds": {"type": "integer", "minimum": 1, "default": 30},
        "timeout_seconds": {"type": "integer", "minimum": 1, "default": 5},
        "retries": {"type": "integer", "minimum": 1, "default": 3},
        "start_period_seconds": {"type": "integer", "minimum": 0, "default": 10}
      },
      "additionalProperties": false
    },
    "resources": {
      "type": ["object", "null"],
      "properties": {
        "memory_limit": {"type": "string"},
        "cpu_shares": {"type": "integer", "minimum": 2}
      },
      "additionalProperties": false
    },
    "log_volume_enabled": {"type": "boolean", "default": false},
    "timezone": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_./+-]+$"}
  },
  "additionalProperties": false
}
