# Dockerfile.web - Censorr Webhook (Gunicorn) image (no ffmpeg, minimal deps)

FROM python:3.12-slim AS builder

WORKDIR /build

# Build tooling
RUN python -m pip install --no-cache-dir --upgrade pip==24.3.1 build==1.2.2

# Copy only what is needed to build the package
COPY pyproject.toml ./
COPY src ./src

# Build a wheel for the project
RUN python -m build --wheel --outdir /dist

FROM python:3.12-slim

# Keep wget only for healthcheck simplicity; no ffmpeg here
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    && rm -rf /var/lib/apt/lists/* && apt-get clean && apt-get autoremove -y && rm -rf /tmp/* /var/tmp/* /var/cache/apt/archives/*

# Non-root user
RUN groupadd -g 1000 censorr && useradd -u 1000 -g censorr -m -s /bin/bash censorr

WORKDIR /app

# Copy code (module imports use src.*) and wheel
COPY --chown=censorr:censorr src/ ./src/
COPY --from=builder /dist /tmp/dist

# Install package from wheel (non-editable)
RUN python -m pip install --no-cache-dir /tmp/dist/*.whl \
    && rm -rf /tmp/dist \
    && mkdir -p /app/config \
    && chown -R censorr:censorr /app

USER censorr

ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

EXPOSE 8000

COPY --chown=censorr:censorr docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["webhook"]
