# Copy to .env and adjust. Every value has a working default.

# Host port for the webhook/API service
CENSORR_PORT=8000

TZ=UTC

# Host paths mounted into the worker
MEDIA_PATH_MOVIES=/mnt/media/movies
MEDIA_PATH_TV=/mnt/media/tv
MEDIA_PATH_TV_CLEAN=/mnt/media/tv-clean

# Directory containing censorr.toml (mounted read-only into both services)
CONFIG_PATH=./config
