# Copy this file to .env and adjust values

# Image selection (optional if building locally)
IMAGE_REPO=jhaycr/censorr
IMAGE_TAG=latest

# Container naming
CONTAINER_NAME=censorr

# Timezone
TZ=UTC

# User/Group IDs (if needed for permissions)
UID=1000
GID=1000

# Media host paths
TV_HOST_PATH=/mnt/media/tv
MOVIES_HOST_PATH=/mnt/media/movies

# Work and config directories
WORKDIR_PATH=/srv/censorr/work
CONFIG_PATH=/srv/censorr/config

# Verbose logging
CENSORR_VERBOSE=false
